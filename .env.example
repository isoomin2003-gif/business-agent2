# 하루 한 장 — 환경변수 예시. 복사해서 .env 로 저장한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)

# 서버 포트 (배포 플랫폼이 자동으로 지정하면 비워 두세요)
PORT=3000

# SQLite DB와 업로드 영상이 저장되는 폴더. 배포 시에는 영구 디스크(볼륨) 경로로 지정하세요. 예: /data
DATA_DIR=./data

# 배포된 사이트 주소 (OpenRouter 요청의 HTTP-Referer 헤더에 사용, 선택)
PUBLIC_URL=

# 업로드 영상 최대 크기(MB)
MAX_VIDEO_MB=80

# ── 기억 찾기(RAG) ──
# OpenRouter API 키. 서버에서만 사용하며 브라우저로 전달되지 않습니다. 비워 두면 'AI 연결 안 됨' 상태로 검색 결과만 보여줍니다.
OPENROUTER_API_KEY=
# 사용할 모델 (https://openrouter.ai/models)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# 기본값을 바꿀 필요는 없습니다 (테스트용 모의 서버를 쓸 때만 변경)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000

# ── 발표 시연 ──
# /demo 페이지에서 별똥별 즉시 발생, 라디오 빨리 감기를 쓰기 위한 비밀 키. 길고 임의의 값으로 정하세요. 비우면 시연 기능이 꺼집니다.
ADMIN_KEY=

# 별똥별 자동 발생 간격(초, 장소별 무작위)
STAR_MIN_SEC=150
STAR_MAX_SEC=420
